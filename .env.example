# Required
DISCORD_TOKEN=
MONGODB_URI=

# Database
MONGODB_DATABASE=VSummary

# Automatic summaries
AUTO_SUMMARY_CHANNEL_ID=

# Discord logging and delivery
DISCORD_LOG_CHANNEL_ID=
DISCORD_SEND_INTERVAL_SECONDS=1.0

# Automatic-summary polling and retries
POLL_INTERVAL_MINUTES=30
SOURCE_RETRY_LIMIT=5
DELIVERY_RETRY_LIMIT=5
HTTP_TIMEOUT_SECONDS=15.0

# Twitch VODs
TWITCH_MAX_DURATION_SECONDS=21600

# Local logging
LOG_FILE_PATH=logs/vsummary.log
LOG_LEVEL=INFO
